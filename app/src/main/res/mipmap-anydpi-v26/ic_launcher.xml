<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <!--
      The layer for Android 13+ themed icons, tinted by the system. The regular foreground
      cannot be used: its code modules and the red sheet are both opaque, so a single tint
      would give a solid square. Only the modules and scanner brackets are kept in alpha.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
