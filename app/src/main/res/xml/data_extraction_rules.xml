<?xml version="1.0" encoding="utf-8"?><!--
   Android Auto Backup rules, API 31 and later.

   The database stays out of the cloud for the same reason as in backup_rules.xml.
   A device-to-device transfer copies it: the app is not running then, so the snapshot
   is consistent. The backup folder grant never moves, it belongs to one device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="sessions.db" />
        <exclude domain="database" path="sessions.db-wal" />
        <exclude domain="database" path="sessions.db-shm" />
        <exclude domain="sharedpref" path="backup.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="backup.xml" />
    </device-transfer>
</data-extraction-rules>
