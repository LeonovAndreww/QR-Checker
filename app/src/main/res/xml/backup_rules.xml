<?xml version="1.0" encoding="utf-8"?><!--
   Android Auto Backup rules before API 31.

   The database is excluded: Room writes through WAL, and a snapshot taken mid-write
   restores corrupted; sessions travel through the app's own backup folder instead.
   backup.xml holds the SAF grant for that folder, which only works on its own device.
-->
<full-backup-content>
    <exclude domain="database" path="sessions.db" />
    <exclude domain="database" path="sessions.db-wal" />
    <exclude domain="database" path="sessions.db-shm" />
    <exclude domain="sharedpref" path="backup.xml" />
</full-backup-content>
