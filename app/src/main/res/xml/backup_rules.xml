<?xml version="1.0" encoding="utf-8"?><!--
   Правила автобэкапа Android, устройства до API 31.

   База не выгружается. Room пишет через WAL, и снимок, снятый посреди записи, приезжает
   обратно битым; сессии для этого переносит собственный бэкап в выбранную папку.

   backup.xml хранит SAF-права на эту папку, а они действуют только на своём устройстве -
   после восстановления папка считалась бы выбранной, но не открывалась.
-->
<full-backup-content>
    <exclude domain="database" path="sessions.db" />
    <exclude domain="database" path="sessions.db-wal" />
    <exclude domain="database" path="sessions.db-shm" />
    <exclude domain="sharedpref" path="backup.xml" />
</full-backup-content>
